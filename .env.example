# Copy to .env and fill in. Never commit the filled file.

# Contact submissions store
NEXT_PUBLIC_MONGODB_URI=

# Contact form spam check
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contact email delivery
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_SES_TO_EMAIL=

# Admin sign-in
NEXT_PUBLIC_ADMIN_USERNAME=
NEXT_PUBLIC_ADMIN_PASSWORD=

# Optional. Omit NEXT_PUBLIC_GA_MEASUREMENT_ID to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ENVIRONMENT=development

# Optional. The token from Search Console's HTML-tag verification method.
# Server-read, so it stays out of the client bundle.
GOOGLE_SITE_VERIFICATION=
